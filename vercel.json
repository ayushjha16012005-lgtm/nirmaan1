{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "redirects": [
    {
      "source": "/apk",
      "destination": "https://github.com/ayushjha16012005-lgtm/nirmaan1/releases/latest/download/Nirmaan.apk",
      "permanent": false
    },
    {
      "source": "/download-apk",
      "destination": "https://github.com/ayushjha16012005-lgtm/nirmaan1/releases/latest/download/Nirmaan.apk",
      "permanent": false
    },
    {
      "source": "/nirmaan.apk",
      "destination": "https://github.com/ayushjha16012005-lgtm/nirmaan1/releases/latest/download/Nirmaan.apk",
      "permanent": false
    },
    {
      "source": "/install-apk",
      "destination": "https://github.com/ayushjha16012005-lgtm/nirmaan1/releases/latest/download/Nirmaan.apk",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/ayushjha16012005-lgtm/nirmaan1/releases/latest",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|icons/|install|sw\\.js|manifest\\.webmanifest|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(self), microphone=(self)"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|manifest\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
